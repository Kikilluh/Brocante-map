{
  "name": "brocante-map",
  "private": true,
  "type": "module",
  "description": "Carte interactive des brocantes et vide-greniers, alimentée automatiquement.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "node scraper/index.mjs",
    "test": "node --check public/app.js && node --test scraper/test/*.test.mjs",
    "demo": "node scraper/tools/make-demo.mjs",
    "serve": "bash scripts/vendor.sh && npx --yes serve public -l 5000",
    "deploy": "npx --yes firebase-tools deploy --only hosting",
    "vendor": "bash scripts/vendor.sh"
  }
}
