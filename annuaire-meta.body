{"visibility": "domain", "fields": [{"name": "plage_ouverture", "description": "Pour les services locaux essentiellement. Horaires d'ouverture au public du service.", "annotations": {}, "label": "plage_ouverture", "type": "text"}, {"name": "site_internet", "description": "Sites internet existants pour le service", "annotations": {}, "label": "site_internet", "type": "text"}, {"name": "copyright", "description": "Administration source de la donn\u00e9e", "annotations": {}, "label": "copyright", "type": "text"}, {"name": "siren", "description": "SIREN du service", "annotations": {}, "label": "siren", "type": "text"}, {"name": "ancien_code_pivot", "description": "NE PLUS UTILISER. Identifiant unique du service. Donn\u00e9e obsol\u00e8te maintenue pour faire le lien avec un ancien flux.", "annotations": {}, "label": "ancien_code_pivot", "type": "text"}, {"name": "reseau_social", "description": "R\u00e9seaux sociaux existants pour le service. Par exemple, url facebook ou twitter etc", "annotations": {}, "label": "reseau_social", "type": "text"}, {"name": "texte_reference", "description": "Textes de lois r\u00e9f\u00e9renc\u00e9s sur le service.", "annotations": {}, "label": "texte_reference", "type": "text"}, {"name": "partenaire", "description": "Mention du partenaire quand le service vient d'une source ext\u00e9rieure (Exemple : Justice...)", "annotations": {}, "label": "partenaire", "type": "text"}, {"name": "telecopie", "description": "Num\u00e9ro de t\u00e9l\u00e9copie du service (tend \u00e0 dispara\u00eetre).", "annotations": {}, "label": "telecopie", "type": "text"}, {"name": "nom", "description": "Nom du service", "annotations": {}, "label": "nom", "type": "text"}, {"name": "siret", "description": "SIRET du service.", "annotations": {}, "label": "siret", "type": "text"}, {"name": "itm_identifiant", "description": "identifiant unique du service avant 2022 (ne sert plus aujourd'hui)", "annotations": {}, "label": "itm_identifiant", "type": "text"}, {"name": "sigle", "description": "Sigle sous lequel le service est connu.", "annotations": {}, "label": "sigle", "type": "text"}, {"name": "affectation_personne", "description": "Ensemble des personnes affect\u00e9es sur le service.", "annotations": {}, "label": "affectation_personne", "type": "text"}, {"name": "date_modification", "description": "Date de modification du service au format texte (JJ/MM/AAAA HH:MM:SS)", "annotations": {}, "label": "date_modification", "type": "text"}, {"name": "date_modification_datetime", "description": "Date de modification du service au format datetime. Norme ISO 8601.\n\n\n\n", "annotations": {"timeserie_precision": "minute"}, "label": "date_modification_datetime", "type": "datetime"}, {"name": "adresse_courriel", "description": "Adresses mail r\u00e9f\u00e9renc\u00e9es pour le service.", "annotations": {}, "label": "adresse_courriel", "type": "text"}, {"name": "service_disponible", "description": "NON UTILISE (vide)", "annotations": {}, "label": "service_disponible", "type": "text"}, {"name": "organigramme", "description": "URL de description de l'organigramme du service.", "annotations": {}, "label": "organigramme", "type": "text"}, {"name": "pivot", "description": "est compos\u00e9 du type de service (exemple cpam, caf, mairie, france_services ...) et de codes insee commune", "annotations": {}, "label": "pivot", "type": "text"}, {"name": "partenaire_identifiant", "description": "En relation avec l'attribut partenaire. Identifiant unique du service c\u00f4t\u00e9 partenaire. Sert de pivot entre la bae du partenaire et la base annuaire.", "annotations": {}, "label": "partenaire_identifiant", "type": "text"}, {"name": "ancien_identifiant", "description": "NE PLUS UTILISER. En relation avec l'attibut ancien_code_pivot, ancien identifiant du service dans l'ancien flux.", "annotations": {}, "label": "ancien_identifiant", "type": "text"}, {"name": "id", "description": "identifiant unique du service", "annotations": {"id": true}, "label": "id", "type": "text"}, {"name": "ancien_nom", "description": "Anciens noms sous lesquels \u00e9tait connu un service lorsqu'il a chang\u00e9 de nom. Exemple : p\u00f4le emploi est devenu france travail.", "annotations": {}, "label": "ancien_nom", "type": "text"}, {"name": "commentaire_plage_ouverture", "description": "Commentaire associ\u00e9 \u00e0 l'ensemble des plages d'ouverture du service.", "annotations": {}, "label": "commentaire_plage_ouverture", "type": "text"}, {"name": "annuaire", "description": "R\u00e9f\u00e9rence de l'url de description d'un annuaire pour le service.", "annotations": {}, "label": "annuaire", "type": "text"}, {"name": "tchat", "description": "url d'un tchat pour le service.", "annotations": {}, "label": "tchat", "type": "text"}, {"name": "hierarchie", "description": "Liens vers les services fils du service permettant de d\u00e9crire l'organisation hi\u00e9rarchique du service.", "annotations": {}, "label": "hierarchie", "type": "text"}, {"name": "categorie", "description": "Pr\u00e9cise la typologie du service : service institutionnel, service institutionnel local, service local.", "annotations": {"facet": true}, "label": "categorie", "type": "text"}, {"name": "sve", "description": "Pr\u00e9cise l'url de signalement par voie \u00e9lectronique pour le service (SVE)", "annotations": {}, "label": "sve", "type": "text"}, {"name": "telephone_accessible", "description": "Pr\u00e9cisions des informations du t\u00e9l\u00e9phone accessible pour les personnes en situation de handicap.", "annotations": {}, "label": "telephone_accessible", "type": "text"}, {"name": "application_mobile", "description": "R\u00e9f\u00e9rence les liens pour les applications mobiles existantes pour le service.", "annotations": {}, "label": "application_mobile", "type": "text"}, {"name": "version_type", "description": "NE PAS UTILISER", "annotations": {}, "label": "version_type", "type": "text"}, {"name": "type_repertoire", "description": "Pr\u00e9cise si le service est de type r\u00e9pertoire (un service r\u00e9pertoire est un service de regroupement d'autres services. Dans ce cas, le service ne comporte pas de coordonn\u00e9es ni d'autres attributs.", "annotations": {}, "label": "type_repertoire", "type": "text"}, {"name": "telephone", "description": "T\u00e9l\u00e9phones r\u00e9f\u00e9renc\u00e9s pour le service.", "annotations": {}, "label": "telephone", "type": "text"}, {"name": "version_etat_modification", "description": "NE PAS UTILISER", "annotations": {}, "label": "version_etat_modification", "type": "text"}, {"name": "date_creation", "description": "Date de cr\u00e9ation du service au format texte ((JJ/MM/AAAA HH:MM:SS). Pr\u00e9f\u00e9rer l'usage de l'attribut date_creation_datetime pour les tris (voir sa description)", "annotations": {}, "label": "date_creation", "type": "text"}, {"name": "date_creation_datetime", "description": "Date de cr\u00e9ation du service au format datetime. Norme ISO 8601.", "annotations": {"timeserie_precision": "minute"}, "label": "date_creation_datetime", "type": "datetime"}, {"name": "partenaire_date_modification", "description": "LI\u00e9 \u00e0 l'attribut partenaire. Date de modification du service par le partenaire.", "annotations": {}, "label": "partenaire_date_modification", "type": "text"}, {"name": "mission", "description": "Description de la mission du service.", "annotations": {}, "label": "mission", "type": "text"}, {"name": "formulaire_contact", "description": "URL du formulaire de contact.", "annotations": {}, "label": "formulaire_contact", "type": "text"}, {"name": "version_source", "description": "NE PAS UTILISER", "annotations": {}, "label": "version_source", "type": "text"}, {"name": "type_organisme", "description": "Pour les services instututionnels. Typologie du service : par ex : administration centrale...", "annotations": {}, "label": "type_organisme", "type": "text"}, {"name": "code_insee_commune", "description": "code insee de la commune", "annotations": {}, "label": "code_insee_commune", "type": "text"}, {"name": "statut_de_diffusion", "description": "NE PAS UTILISER", "annotations": {}, "label": "statut_de_diffusion", "type": "text"}, {"name": "adresse", "description": "Adresses (physique et/ou postale) r\u00e9f\u00e9renc\u00e9es pour le service.", "annotations": {}, "label": "adresse", "type": "text"}, {"name": "url_service_public", "description": "Pr\u00e9cice l'url du service sur le site https://annuaire.service-public.fr/", "annotations": {}, "label": "url_service_public", "type": "text"}, {"name": "information_complementaire", "description": "Informations d'ordre g\u00e9n\u00e9ral compl\u00e9mentaires sur le service.", "annotations": {}, "label": "information_complementaire", "type": "text"}, {"name": "date_diffusion", "description": "NE PAS UTILISER.", "annotations": {}, "label": "date_diffusion", "type": "text"}], "dataset_id": "api-lannuaire-administration", "dataset_uid": "da_eqyprz", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [{"id": "documentation_technique_api_annuaire_de_l_administration_pdf", "title": "Documentation-technique-API-Annuaire-de-l-administration.pdf", "mimetype": "application/pdf", "url": "https://api-lannuaire.service-public.fr/api/explore/v2.1/catalog/datasets/api-lannuaire-administration/attachments/documentation_technique_api_annuaire_de_l_administration_pdf"}], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "api-lannuaire-administration", "description": null, "theme": null, "keyword": null, "license": null, "license_url": null, "language": "fr", "modified": "2023-12-11T09:14:51+00:00", "publisher": null, "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2026-11-02T03:37:49.126000+00:00", "federated": false, "geographic_reference": null, "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["fr"], "metadata_processed": "2026-11-02T03:37:49.287000+00:00", "modified_upda